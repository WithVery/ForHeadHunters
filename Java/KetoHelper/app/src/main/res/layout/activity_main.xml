<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/lblProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/searchproduct"
        android:gravity="center"
        android:padding="8dp"
        android:textAppearance="?android:textAppearanceLarge"
        tools:layout_editor_absoluteX="20dp"
        tools:layout_editor_absoluteY="51dp" />

    <AutoCompleteTextView
        android:id="@+id/autocomplete"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:completionThreshold="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textAppearance="?android:textAppearanceLarge"
        android:hint = "Например, Петрушка"
        android:paddingLeft="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btnSearchProduct"
        app:layout_constraintRight_toLeftOf="@id/btnSearchProduct"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblProduct"
        />

    <Button
        android:id="@+id/btnSearchProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:onClick="showProdSearchResult"
        android:padding="8dp"
        android:text="@string/btnSearchName"
        android:backgroundTint="@color/search_button_gray"
        app:layout_constraintRight_toRightOf="@id/lblProduct"
        app:layout_constraintTop_toBottomOf="@+id/lblProduct" />

    <TextView
        android:id="@+id/textHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="Вы уже искали"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:background="@color/keto_green"
        app:layout_constraintTop_toBottomOf="@id/autocomplete"
        />

    <ListView
        android:id="@+id/listHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/list_history_gray"
        app:layout_constraintTop_toBottomOf="@+id/textHistoryTitle" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/send_email_button"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="15dp"
        app:backgroundTint="@color/keto_green"
        app:srcCompat="@android:drawable/ic_dialog_email" />

</androidx.constraintlayout.widget.ConstraintLayout>